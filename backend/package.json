{
  "name": "agent-service-backend",
  "version": "1.0.0",
  "description": "Agent for Service - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check:invoices": "node scripts/checkInvoiceBoundary.js",
    "verify:invoices": "node scripts/checkInvoiceBoundary.js && node scripts/verifyInvoices.js",
    "verify:architecture": "node scripts/verifyArchitecture.js",
    "verify:notifications": "node scripts/verifyNotifications.js",
    "verify:race": "node scripts/verifyPaymentRace.js",
    "verify:email": "node scripts/verifyEmailLinks.js",
    "verify:all": "node scripts/checkInvoiceBoundary.js && node scripts/verifyArchitecture.js && node scripts/verifyInvoices.js && node scripts/verifyNotifications.js && node scripts/verifyAdminSurface.js && node scripts/verifyUserFlows.js && node scripts/verifyReminderCap.js && node scripts/verifyPaymentRace.js && node scripts/verifyEmailLinks.js && node scripts/verifyProfileSettings.js",
    "verify:admin": "node scripts/verifyAdminSurface.js",
    "verify:userflows": "node scripts/verifyUserFlows.js",
    "verify:remindercap": "node scripts/verifyReminderCap.js",
    "verify:profile": "node scripts/verifyProfileSettings.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mjml": "^5.4.1",
    "mongoose": "^9.13.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "socket.io": "^4.8.4",
    "stripe": "^23.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "mjml": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    },
    "nodemon": {
      "minimatch": "^11.0.1"
    }
  }
}
